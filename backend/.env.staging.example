# V2 staging backend environment — NAMES ONLY (set values in Railway dashboard).
# Never copy production DATABASE_URL / JWT_SECRET / encryption secrets.

# --- Required core ---
DATABASE_URL=
JWT_SECRET=
PORT=4000
NODE_ENV=production
FRONTEND_URL=
CORS_ORIGIN=

# --- V2 staging markers / safety ---
COMMENT2DM_DEPLOYMENT_ENV=staging
SMART_CAMPAIGNS_ENABLED=true
COMMENT2DM_ALLOW_REMOTE_V2_DB=true

# --- Staging Meta stub (Level 1) — all three required together ---
META_PRIVATE_REPLY_STUB=true
COMMENT2DM_ALLOW_META_STUB=true

# --- Webhook fixture signing (staging-only secret; not production Meta webhook) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_VERIFY_TOKEN=

# --- Explicitly unset / do not set on staging if unused ---
# META_OAUTH_ENABLED=
# STRIPE_SECRET_KEY=
# Do not set production Railway domain values in FRONTEND_URL / CORS_ORIGIN.
