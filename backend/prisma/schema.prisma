generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DmEventStatus {
  sending
  sent
  failed
  /** Claimed for processing but no active keyword rule matched. */
  skipped
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  name                       String?
  passwordHash               String
  /** Set when the user accepted Terms of Service at registration (or later). */
  termsAcceptedAt            DateTime?
  /** Set when the user accepted the Privacy Policy at registration (or later). */
  privacyAcceptedAt          DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  keywordRules               KeywordRule[]
  dmEvents                   DmEvent[]
  leads                      Lead[]
  instagramConnectionRequest InstagramConnectionRequest?
  instagramAccount           InstagramAccount?
  activityEvents             ActivityEvent[]
  subscription               Subscription?
  billingEvents              BillingEvent[]
  campaigns                  Campaign[]
  passwordResetTokens        PasswordResetToken[]

  @@map("users")
}

/** One-time password reset token. Store SHA-256 hash only — never the plaintext. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model KeywordRule {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword             String
  dmMessage           String
  isActive            Boolean  @default(true)
  /**
   * Instagram media ID this rule is scoped to.
   * Null = global (all posts). Matching uses this field, not cached preview metadata.
   */
  instagramMediaId    String?
  /**
   * Non-null uniqueness helper: "__GLOBAL__" when instagramMediaId is null,
   * otherwise the Instagram media ID. Enforces one rule per (user, keyword, scope).
   */
  mediaScopeKey       String   @default("__GLOBAL__")
  /** Cached for Rules dashboard display only — not used for webhook matching. */
  mediaType           String?
  mediaThumbnailUrl   String?
  mediaCaption        String?
  mediaPermalink      String?
  /** Instagram media publish time (UTC). Display-only; never used for matching. */
  mediaTimestamp      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  dmEvents            DmEvent[]
  campaigns           Campaign[]

  @@unique([userId, keyword, mediaScopeKey])
  @@index([userId, keyword])
  @@map("keyword_rules")
}

model DmEvent {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId             String?
  rule               KeywordRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  commentId          String
  status             DmEventStatus    @default(sending)
  mediaId            String?
  messageId          String?
  errorSummary       String?
  /** Meta Graph API error.code from the last failed private-reply attempt. */
  metaErrorCode      Int?
  /** Meta Graph API error.message from the last failed private-reply attempt (sanitized). */
  metaErrorMessage   String?
  attemptCount       Int              @default(1)
  lastAttemptAt      DateTime?
  createdAt          DateTime         @default(now())
  campaignClaims     CampaignClaim[]

  @@unique([instagramAccountId, commentId])
  @@index([userId, createdAt])
  @@map("dm_events")
}

model Lead {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("leads")
}

model InstagramConnectionRequest {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramUsername String
  status            String   @default("waitlist")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("instagram_connection_requests")
}

model InstagramAccount {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramUserId         String    @unique
  username                String
  accountType             String
  profilePictureUrl       String?
  accessTokenEncrypted    String    @default("mock_encrypted_token_placeholder")
  pageId                  String?
  connectionStatus        String    @default("disconnected")
  connectedAt             DateTime?
  lastSyncAt              DateTime?
  /** Set when POST /{ig-user-id}/subscribed_apps succeeds for this account. */
  webhookSubscribedAt     DateTime?
  webhookSubscribedFields String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  dmEvents                DmEvent[]

  @@map("instagram_accounts")
}

model ActivityEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_events")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("starter")
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

model BillingEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?  @unique
  amount          Int
  currency        String   @default("usd")
  status          String
  description     String?
  invoiceUrl      String?
  createdAt       DateTime @default(now())

  @@map("billing_events")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum CampaignCodeStatus {
  AVAILABLE
  RESERVED
  CLAIMED
  REDEEMED
  DISABLED
}

enum CampaignClaimDeliveryStatus {
  PENDING
  SENT
  FAILED
  EXHAUSTED
}

/**
 * V2 Smart Campaign aggregate. Additive only — unused while SMART_CAMPAIGNS_ENABLED=false.
 * One ACTIVE campaign per KeywordRule is enforced by a partial unique index in SQL.
 */
model Campaign {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordRuleId         String
  keywordRule           KeywordRule    @relation(fields: [keywordRuleId], references: [id], onDelete: Restrict)
  name                  String
  status                CampaignStatus @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  maxClaims             Int
  claimedCount          Int            @default(0)
  dmTemplate            String
  soldOutMessage        String
  alreadyClaimedMessage String
  notStartedMessage     String?
  endedMessage          String?
  redemptionEnabled     Boolean        @default(false)
  archivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  codes                 CampaignCode[]
  claims                CampaignClaim[]

  @@index([userId, status])
  @@index([keywordRuleId, status])
  @@map("campaigns")
}

model CampaignCode {
  id           String             @id @default(cuid())
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  code         String
  status       CampaignCodeStatus @default(AVAILABLE)
  reservedAt   DateTime?
  claimedAt    DateTime?
  redeemedAt   DateTime?
  qrPayload    String?
  barcodeValue String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  claim        CampaignClaim?

  @@unique([campaignId, code])
  @@index([campaignId, status])
  @@map("campaign_codes")
}

model CampaignClaim {
  id                   String                       @id @default(cuid())
  campaignId           String
  campaign             Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignCodeId       String                       @unique
  campaignCode         CampaignCode                 @relation(fields: [campaignCodeId], references: [id], onDelete: Restrict)
  sourceCommentId      String
  /** Webhook from.id — required for one-claim-per-user; null allowed by schema, fail-closed in app logic later. */
  instagramCommenterId String?
  /** Display only — never used for uniqueness. */
  instagramUsername    String?
  dmEventId            String?
  dmEvent              DmEvent?                     @relation(fields: [dmEventId], references: [id], onDelete: SetNull)
  deliveryStatus       CampaignClaimDeliveryStatus  @default(PENDING)
  claimedAt            DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([campaignId, sourceCommentId])
  @@index([campaignId, claimedAt])
  @@map("campaign_claims")
}
